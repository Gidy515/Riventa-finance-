{
  "name": "@riventa/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "PGDATABASE=riventa_test node --import tsx --test src/domain/trades/*.test.ts src/near/*.test.ts src/workspace/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "fastify": "5.6.2",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
